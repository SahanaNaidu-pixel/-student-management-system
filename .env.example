# Copy this file to .env and adjust the values.

# Web server
PORT=3000
HOST=127.0.0.1

# SQLite database file and profile photo folder (relative to the project root)
DB_PATH=data/sms.db
UPLOAD_DIR=data/uploads

# Login sessions
SESSION_TTL_HOURS=8
# Set to true when the app is served over HTTPS
COOKIE_SECURE=false
# Set to true behind a hosting proxy (Render, Nginx) so login limits use the real client IP
TRUST_PROXY=false

# "demo" loads sample students, courses and marks; "accounts" creates only the user accounts
SEED_MODE=demo

# Accounts created by `npm run seed` (demo environment only - change them for real use).
# The staff account is optional: leave both staff values empty to skip it.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=Admin@12345
SEED_STAFF_USERNAME=staff
SEED_STAFF_PASSWORD=Staff@12345
